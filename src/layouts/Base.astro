---
import { profile } from '../data/site';
interface Props { title?: string; description?: string }
const { title = `${profile.name} — ${profile.title}`, description = profile.tagline } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="wrap nav">
      <a href="/" class="brand">{profile.name}</a>
      <nav>
        <a href="/#impact">Impact</a>
        <a href="/#building">Building</a>
        <a href="/#experience">Experience</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="wrap foot">© {new Date().getFullYear()} {profile.name}</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7; --fg: #1b1b1f; --muted: #5d5d66; --line: #e6e3dc; --accent: #1f5f8b; --card: #ffffff;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #111214; --fg: #ececee; --muted: #a0a0aa; --line: #26272b; --accent: #7cb4dc; --card: #17181b; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.65 Inter, system-ui, sans-serif; }
  .wrap { max-width: 860px; margin: 0 auto; padding: 0 20px; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h1, h2 { font-family: 'Source Serif 4', Georgia, serif; font-weight: 600; letter-spacing: -0.01em; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.1rem); line-height: 1.1; margin: 0 0 12px; }
  h2 { font-size: 1.6rem; margin: 0 0 20px; }
  section { padding: 48px 0; border-top: 1px solid var(--line); }
  .nav { display: flex; justify-content: space-between; align-items: center; padding-top: 24px; padding-bottom: 24px; flex-wrap: wrap; gap: 12px; }
  .nav nav { display: flex; gap: 20px; font-size: 0.95rem; }
  .nav nav a { color: var(--muted); }
  .brand { font-weight: 600; color: var(--fg); }
  .muted { color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 20px; }
  .card h3 { margin: 0 0 6px; font-size: 1.05rem; }
  .card p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .pill { display: inline-block; font-size: 0.75rem; padding: 2px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }
  .foot { padding: 40px 20px; color: var(--muted); font-size: 0.85rem; border-top: 1px solid var(--line); }
</style>
