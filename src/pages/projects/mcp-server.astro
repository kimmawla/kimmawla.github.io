---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/site';
const p = projects.find((x) => x.slug === 'mcp-server')!;
---
<Base title={`${p.name} — MCP server`} description={p.summary}>
  <p><a href="/#building">← Back</a></p>
  <span class="pill">{p.status}</span>
  <h1 style="margin-top:12px">{p.name}</h1>
  <p class="muted">{p.summary}</p>

  <section>
    <h2>What it does</h2>
    <p>Describe the problem, who it's for, and the tools it exposes.</p>
  </section>

  <section>
    <h2>Install</h2>
    <pre><code>uvx {p.name}</code></pre>
    <p class="muted">Or add to your MCP client config — see the repo README.</p>
  </section>

  <section>
    <h2>How I built it</h2>
    <p>FastMCP + Claude Code. Note design decisions, security posture (auth, tool scoping, input validation), and evals.</p>
  </section>

  <section>
    <h2>Links</h2>
    <ul>
      <li><a href={p.links.repo}>Source on GitHub</a></li>
      <li><a href={p.links.registry}>Official MCP Registry listing</a></li>
      <li><a href={p.links.pypi}>PyPI package</a></li>
    </ul>
  </section>
</Base>

<style>
  pre { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 14px; overflow-x: auto; }
</style>
