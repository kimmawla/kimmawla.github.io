---
import Base from '../layouts/Base.astro';
import { profile, impact, experience, projects, writing } from '../data/site';
---
<Base>
  <div class="hero">
    <h1>{profile.name}</h1>
    <p class="role">{profile.title}</p>
    <p class="lede">{profile.tagline}</p>
    <p class="cta">
      <a href={profile.links.resume}>Résumé</a> ·
      <a href={profile.links.linkedin}>LinkedIn</a> ·
      <a href={profile.links.github}>GitHub</a>
    </p>
  </div>

  <section id="impact">
    <h2>Selected impact</h2>
    <div class="grid">
      {impact.map((i) => (
        <div class="card"><h3>{i.title}</h3><p>{i.body}</p></div>
      ))}
    </div>
  </section>

  <section id="building">
    <h2>Building</h2>
    <p class="muted">Hands-on work in agentic AI and the Model Context Protocol.</p>
    <div class="grid">
      {projects.map((p) => (
        <a class="card" href={`/projects/${p.slug}/`}>
          <span class="pill">{p.status}</span>
          <h3 style="margin-top:10px">{p.name}</h3>
          <p>{p.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="experience">
    <h2>Experience</h2>
    <ul class="xp">
      {experience.map((e) => (
        <li><strong>{e.role}</strong>, {e.org}{e.years && <span class="muted"> · {e.years}</span>}</li>
      ))}
    </ul>
    <p class="muted">B.S. Computer Science, Cornell University</p>
  </section>

  {writing.length > 0 && (
    <section id="writing">
      <h2>Writing</h2>
      <ul>{writing.map((w) => <li><a href={w.url}>{w.title}</a> <span class="muted">· {w.venue}</span></li>)}</ul>
    </section>
  )}

  <section id="contact">
    <h2>Contact</h2>
    <p>Based in {profile.location}. Reach me at <a href={`mailto:${profile.email}`}>{profile.email}</a> or on <a href={profile.links.linkedin}>LinkedIn</a>.</p>
  </section>
</Base>

<style>
  .hero { padding: 56px 0 64px; }
  .role { font-size: 1.15rem; font-weight: 500; margin: 0 0 16px; }
  .lede { font-size: 1.1rem; color: var(--muted); max-width: 640px; margin: 0 0 20px; }
  .xp { padding-left: 18px; margin: 0 0 16px; }
  .xp li { margin-bottom: 6px; }
  a.card:hover { text-decoration: none; border-color: var(--accent); }
</style>
