---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/site';
const p = projects.find((x) => x.slug === 'mcp-server')!;
---
<Base title={`${p.name} — MCP server`} description={p.summary}>
  <p><a href="/#building">← Back</a></p>
  <span class="pill">{p.status}</span>
  <h1 style="margin-top:12px">{p.name}</h1>
  <p class="muted">{p.summary}</p>

  <section>
    <h2>What it does</h2>
    <p>CVSS ranks vulnerabilities by severity, not by how likely they are to be exploited. This server adds exploit probability (FIRST EPSS) and known exploitation (CISA KEV) to CVSS severity, and shows its reasoning. It exposes five tools:</p>
    <ul>
      <li><code>triage_vulnerability</code>: prioritize one CVE or GHSA advisory with a 0-100 score, bucket, confidence, and reasoning</li>
      <li><code>lookup_vulnerability</code>: raw advisory details from OSV.dev</li>
      <li><code>find_vulns_for_package</code>: known vulnerabilities affecting a package, or one version of it</li>
      <li><code>get_epss_score</code>: exploit probability for one CVE</li>
      <li><code>check_known_exploited</code>: whether a CVE is in CISA's KEV catalog</li>
    </ul>
  </section>

  <section>
    <h2>Install</h2>
    <pre><code>uvx {p.name}</code></pre>
    <p class="muted">Or add to your MCP client config — see the repo README.</p>
    <p>Then ask your agent, for example: “Which is most urgent: CVE-2021-44228, CVE-2023-4863, CVE-2019-10744?”</p>
  </section>

  <section>
    <h2>Demo</h2>
